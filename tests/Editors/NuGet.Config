<configuration>
  <config>
    <add key="globalPackagesFolder" value="../../artifacts/editor-test-cache" />
  </config>
  <packageSources>
    <clear />
    <add key="packed" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="packed"><package pattern="AurorisNet.Umbraco.Drawio*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
