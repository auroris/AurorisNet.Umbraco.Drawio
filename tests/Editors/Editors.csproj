<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
    <CompressionEnabled>false</CompressionEnabled>
    <DrawioPackageVersion Condition="'$(DrawioPackageVersion)' == ''">0.0.0-dev</DrawioPackageVersion>
    <EditorPackage Condition="'$(EditorPackage)' == ''">AurorisNet.Umbraco.Drawio</EditorPackage>
    <DefineConstants Condition="'$(EditorPackage)' == 'AurorisNet.Umbraco.Drawio.Selfhosted'">$(DefineConstants);SELFHOSTED</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WithApplicationVirtualPathFix)' == 'true'">
    <DefineConstants>$(DefineConstants);APPLICATION_VIRTUAL_PATH_FIX</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(WithApplicationVirtualPathFix)' == 'true'">
    <PackageReference Include="AurorisNet.Umbraco.ApplicationVirtualPathFix" VersionOverride="[18.3.2.1]" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="$(EditorPackage)" VersionOverride="[$(DrawioPackageVersion)]" />
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="xunit.v3" />
    <Compile Include="../AurorisNet.Umbraco.Drawio.Tests/TestSite.cs" Link="TestSite.cs" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
