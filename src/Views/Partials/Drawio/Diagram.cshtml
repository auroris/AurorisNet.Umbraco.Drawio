@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement>
@using Drawio
@*
    A diagram element: the selected image, its selected click action and its caption. The block views below render it, and a
    site's own element type with an image, caption and altText property can render it too:
    @await Html.PartialAsync("~/Views/Partials/Drawio/Diagram.cshtml", element)
    Copy this file to the same path in the site to change the markup; the site's copy takes precedence.
    DiagramFigure reads the element and chooses the link, so a copy needs nothing else from the package.
*@
@{
    var diagram = DiagramFigure.From(Model, Context);
}
@if (diagram.ImageUrl is not null)
{
    <figure class="drawio-diagram @diagram.CssClass">
        <drawio-diagram-image data-inline-svg="@(diagram.InlineSvg ? "true" : null)" style="display:inline-block;position:relative;max-width:100%;vertical-align:middle">
            @if (diagram.Href is not null)
            {
                <a href="@diagram.Href" target="@diagram.Target" rel="@(diagram.Target == "_blank" ? "noopener" : null)" aria-label="@diagram.LinkLabel">
                    <img src="@diagram.ImageUrl" alt="@diagram.AltText" loading="lazy" style="display:block;max-width:100%;height:auto" />
                </a>
            }
            else
            {
                <img src="@diagram.ImageUrl" alt="@diagram.AltText" loading="lazy" style="display:block;max-width:100%;height:auto" />
            }
            @if (diagram.Map is { } map)
            {
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="@map.ViewBox" preserveAspectRatio="none"
                     style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none">
                    @foreach (var region in map.Links)
                    {
                        <a href="@region.Href" aria-label="@(string.IsNullOrWhiteSpace(region.Label) ? region.Href : region.Label)"
                           target="@(region.NewTab ? "_blank" : null)" rel="@(region.NewTab ? "noopener" : null)">
                            @foreach (var shape in region.Shapes)
                            {
                                <path d="@shape.D" transform="@shape.Transform" fill="transparent" stroke="transparent"
                                      stroke-width="@shape.StrokeWidth?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                      pointer-events="@(shape.StrokeWidth.HasValue ? "stroke" : "fill")" />
                            }
                        </a>
                    }
                </svg>
            }
        </drawio-diagram-image>
        @if (diagram.Caption is not null)
        {
            <figcaption>@diagram.Caption</figcaption>
        }
    </figure>
    @if (diagram.InlineSvg)
    {
        <script type="module" src="@Url.Content($"~{DrawioPaths.Plugin}/inline-svg.js")"></script>
    }
}
