@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement>
@using Drawio
@*
    A diagram element: the PNG, its selected click action and its caption. The block views below render it, and a
    site's own element type with an image, caption and altText property can render it too:
    @await Html.PartialAsync("~/Views/Partials/Drawio/Diagram.cshtml", element)
    Copy this file to the same path in the site to change the markup; the site's copy takes precedence.
    DiagramFigure reads the element and chooses the link, so a copy needs nothing else from the package.
*@
@{
    var diagram = DiagramFigure.From(Model, Context);
}
@if (diagram.ImageUrl is not null)
{
    <figure class="drawio-diagram">
        @if (diagram.Href is not null)
        {
        <a href="@diagram.Href" target="@diagram.Target" rel="@(diagram.Target == "_blank" ? "noopener" : null)" aria-label="@diagram.LinkLabel">
            <img src="@diagram.ImageUrl" alt="@diagram.AltText" loading="lazy" style="max-width:100%;height:auto" />
        </a>
        }
        else
        {
            <img src="@diagram.ImageUrl" alt="@diagram.AltText" loading="lazy" style="max-width:100%;height:auto" />
        }
        @if (diagram.Caption is not null)
        {
            <figcaption>@diagram.Caption</figcaption>
        }
    </figure>
}
