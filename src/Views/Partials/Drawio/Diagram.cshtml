@inherits UmbracoViewPage<IPublishedElement>
@using Drawio
@using Drawio.Compatibility
@using Microsoft.Extensions.DependencyInjection
@*
    A diagram element: the PNG, its selected click action and its caption. The block views below render it, and a
    site's own element type with an image, caption and altText property can render it too:
    @await Html.PartialAsync("~/Views/Partials/Drawio/Diagram.cshtml", element)
    Copy this file to the same path in the site to change the markup; the site's copy takes precedence.
*@
@{
    var diagram = Context.RequestServices.GetRequiredService<IUmbracoApi>().ReadDiagram(Model);
    var caption = diagram.Caption;
    var language = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var label = diagram.Label;
    var action = diagram.Action;
    var viewer = DrawioPaths.ViewerUrl(Context.Request.PathBase, diagram.OriginalUrl ?? "", language);
    var href = action == DiagramClickAction.Viewer ? viewer : action == DiagramClickAction.Link ? diagram.LinkUrl : null;
    // Link picker values are editor input. Never render executable or protocol-relative URLs.
    if (href is not null && !(href.StartsWith('/') && !href.StartsWith("//") && !href.Contains('\\'))
        && !href.StartsWith('#') && !(Uri.TryCreate(href, UriKind.Absolute, out var absolute) && absolute.Scheme is "http" or "https" or "mailto" or "tel")) href = null;
    var target = action == DiagramClickAction.Viewer ? "_blank" : diagram.LinkTarget;
    var alt = diagram.AltText;
}
@if (diagram.ImageUrl is not null)
{
    <figure class="drawio-diagram">
        @if (!string.IsNullOrWhiteSpace(href))
        {
        <a href="@href" target="@target" rel="@(target == "_blank" ? "noopener" : null)" aria-label="@(action == DiagramClickAction.Viewer ? label : diagram.LinkName)">
            <img src="@diagram.ImageUrl" alt="@(string.IsNullOrWhiteSpace(alt) ? caption ?? label : alt)" loading="lazy" style="max-width:100%;height:auto" />
        </a>
        }
        else
        {
            <img src="@diagram.ImageUrl" alt="@(string.IsNullOrWhiteSpace(alt) ? caption ?? label : alt)" loading="lazy" style="max-width:100%;height:auto" />
        }
        @if (!string.IsNullOrWhiteSpace(caption))
        {
            <figcaption>@caption</figcaption>
        }
    </figure>
}
