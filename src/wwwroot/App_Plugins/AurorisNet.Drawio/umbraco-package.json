{
  "id": "AurorisNet.Umbraco.Drawio",
  "name": "draw.io for Umbraco",
  "extensions": [
    {
      "type": "propertyEditorUi",
      "alias": "AurorisNet.Drawio.Editor",
      "name": "Diagram picker",
      "element": "/App_Plugins/AurorisNet.Drawio/editor.js",
      "meta": {
        "label": "Diagram (draw.io)",
        "icon": "icon-diagram",
        "group": "media",
        "propertyEditorSchemaAlias": "Umbraco.MediaPicker3"
      }
    },
    {
      "type": "blockEditorCustomView",
      "alias": "AurorisNet.Drawio.Preview.Grid",
      "name": "Diagram preview in a Block Grid",
      "weight": 1000,
      "element": "/App_Plugins/AurorisNet.Drawio/block-preview.js",
      "forContentTypeAlias": "drawioDiagram",
      "forBlockEditor": "block-grid"
    },
    {
      "type": "blockEditorCustomView",
      "alias": "AurorisNet.Drawio.Preview.List",
      "name": "Diagram preview in a Block List",
      "weight": 1000,
      "element": "/App_Plugins/AurorisNet.Drawio/block-preview.js",
      "forContentTypeAlias": "drawioDiagram",
      "forBlockEditor": "block-list"
    }
  ]
}
